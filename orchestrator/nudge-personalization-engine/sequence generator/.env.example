# ============================================
# API KEYS
# ============================================

# Google Gemini (for strategy generation)
GOOGLE_API_KEY=AIzaSyCMvdvnd27TmX6wsm0hoURn_Ug_fE77fXg

# # Hunter.io (for contact discovery)
# HUNTER_API_KEY=your_hunter_api_key_here

# # Tavily (for web research)
# TAVILY_API_KEY=your_tavily_api_key_here

# ============================================
# GEMINI CONFIGURATION
# ============================================
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_FALLBACK_MODEL=models/gemma-3-27b-it
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2048

# ============================================
# MCP CLIENT CONFIGURATION (Message Generator)
# ============================================

# Connection mode: "stdio" (subprocess) or "sse" (HTTP)
MCP_CONNECTION_MODE=stdio

# For SSE mode (if MCP_CONNECTION_MODE=sse)
MCP_SERVER_URL=http://localhost:8000/mcp

# Message generator base URL (for REST fallback or direct API calls)
MESSAGE_GENERATOR_URL=http://localhost:8000

# For stdio mode (if MCP_CONNECTION_MODE=stdio)
# Command to run the message generator MCP server
MCP_SERVER_COMMAND=python -m app.mcp_server
# Working directory where message generator is located
# For WSL, use absolute path: /mnt/c/Users/ASUS/Desktop/Outreach-Project/message generator and sender
# For Windows/Unix, use relative path: ../message generator and sender
MCP_SERVER_CWD=../message generator and sender

# ============================================
# SENDER CONFIGURATION (for message generation)
# ============================================

# Your company info
SENDER_COMPANY_NAME=Votre Entreprise
SENDER_ELEVATOR_PITCH=Nous aidons les entreprises à grandir avec nos solutions innovantes.

# Default offer to pitch
DEFAULT_OFFER_NAME=Audit Gratuit
DEFAULT_OFFER_SUMMARY=Diagnostic personnalisé de vos processus pour identifier les opportunités d'amélioration.
DEFAULT_OFFER_CTA=Réserver un appel de 15 minutes pour discuter de vos besoins.

# ============================================
# DEBUG MODE
# ============================================
# true  = memory reads/writes bypassed in the message generator (deterministic).
# false = full memory active (production).
#
# The orchestrator pushes DEBUG_MODE to this module (and onward to the message
# generator) at runtime, so the value in outreach orchestrator/.env takes
# precedence. This file's value is the fallback if the orchestrator is not used.
DEBUG_MODE=true

# ============================================
# LINKEDIN INMAIL ENFORCEMENT
# ============================================
# Server-side safety net that corrects Gemini output when InMail routing
# instructions are ignored. Set to false to disable auto-correction.
ENFORCE_INMAIL_WHEN_CREDITS_AVAILABLE=true
INMAIL_FALLBACK_TO_CONNECT_IF_NO_CREDITS=true

# ============================================
# SEQUENCE LENGTH CONSTRAINT
# ============================================
# Default maximum number of outreach steps when the caller does not specify max_touches.
# Can be overridden per-request via the API. Server-side enforcement rejects sequences exceeding this.
DEFAULT_MAX_TOUCHES=5

# API Keys

# Gemini Configuration
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_FALLBACK_MODEL=models/gemma-3-27b-it
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2048