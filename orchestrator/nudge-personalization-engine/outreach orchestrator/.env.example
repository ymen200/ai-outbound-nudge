# Outreach Orchestrator — environment configuration
# Copy this file to .env and adjust values as needed.

# Server
HOST=0.0.0.0
PORT=8002

# Downstream module URLs (Docker service names when running via docker-compose)
SEQUENCE_GENERATOR_URL=http://sequence-generator:8001
MESSAGE_GENERATOR_URL=http://message-generator:8000

# Request timeouts (seconds)
SEQUENCE_GENERATOR_TIMEOUT=120
MESSAGE_GENERATOR_TIMEOUT=120
OBSERVABILITY_TIMEOUT=10

# Logging
LOG_LEVEL=INFO

# Debug mode — bypass memory for deterministic test runs
DEBUG_MODE=True
# Outreach Orchestrator Configuration
# Copy this to .env and modify as needed

# Server
HOST=0.0.0.0
PORT=8002
ENVIRONMENT=development

# Downstream module URLs
SEQUENCE_GENERATOR_URL=http://localhost:8001
MESSAGE_GENERATOR_URL=http://localhost:8000

# Request timeouts (seconds)
SEQUENCE_GENERATOR_TIMEOUT=120
MESSAGE_GENERATOR_TIMEOUT=120
OBSERVABILITY_TIMEOUT=10

# Logging
LOG_LEVEL=INFO

# Debug mode — SOURCE OF TRUTH for both modules
# true  = bypass memory reads/writes in message generator (deterministic, for testing)
# false = full memory active (production: prospect history, learning, hook dedup)
#
# This value is propagated to sequence generator + message generator at runtime
# via the apply_config_overrides node. Can also be overridden per-request in the
# API payload: {"debug_mode": false, ...}
DEBUG_MODE=true
