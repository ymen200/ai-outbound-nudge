# Paths to module MCP entrypoints (stdio)
QUALIFIER_MCP_PATH=../nudge-qualifier-engine/qualifier_agent/qualifier_mcp/run.py
SOURCER_MCP_PATH=../inject_collect_project/mcp_server.py
OUTREACH_ORCH_URL=http://localhost:8002
# Optional Python interpreters for each module (defaults to current python)
QUALIFIER_PYTHON=
SOURCER_PYTHON=

# Max seconds per qualifier/sourcer MCP tool call (personas+signals often >120s)
QUALIFIER_TIMEOUT=180.0
SOURCER_TIMEOUT=300.0
QUALIFIER_MAX_RETRIES=0
SOURCER_MAX_RETRIES=1
MCP_RETRY_BACKOFF_BASE=2.0

# SQLite campaign store (legacy / migration source only)
DATABASE_PATH=./data/orchestrator.db

# PostgreSQL campaign store (primary)
DATABASE_BACKEND=postgres
# Optional full URL; if unset, built from POSTGRES_* below
# DATABASE_URL=postgresql://nudge-staging:nudge@127.0.0.1:5432/nudge-ai-outreach
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=nudge-ai-outreach
POSTGRES_USER=nudge-staging
POSTGRES_PASSWORD=nudge
POSTGRES_REMOTE_HOST=127.0.0.1

# SSH tunnel to reach staging PostgreSQL (disable if you tunnel manually)
SSH_TUNNEL_ENABLED=true
SSH_HOST=51.222.29.207
SSH_PORT=22
SSH_USER=ubuntu
SSH_PASSWORD=

# Sourcer fetch limits
# COMPANY_LIMIT: how many companies to fetch and score (firmographic pass eliminates weak fits)
COMPANY_LIMIT=6
COMPANY_LIMIT_PER_ELEMENT=3
# After intent rescore, top N companies (by total_score) get personas fetched.
# Omit to use COMPANY_LIMIT.
COMPANIES_FOR_PERSONA_FETCH=3
PERSONA_LIMIT=3
PERSONA_LIMIT_PER_ELEMENT=2
# Combined score for choosing the single lead to enrich: company_total * W1 + persona * W2
LEAD_COMPANY_SCORE_WEIGHT=0.4
LEAD_PERSONA_SCORE_WEIGHT=0.6

# Preferred-city proximity radius (km) for qualifier geo scoring.
# Outside this radius companies are kept but firmographic score is reduced by 3%.
# Passed to the qualifier as configurable_weights.max_km_radius.
MAX_KM_RADIUS=50.0

# ── Blacklist (passed to qualifier) ───────────────────────────────────────
# Companies: names or regex patterns (case-insensitive). "Microsoft" matches
# "Microsoft Corporation", "microsoft corp", etc. JSON array.
BLACKLIST_COMPANIES=["Gitlab"]
# Personas: LinkedIn profile URLs to never contact. JSON array.
BLACKLIST_PERSONAS=[]

# ── Qualifier firmographic weights (qualifier_agent/brain/config.py) ──────
INDUSTRY_WEIGHT=0.40
SIZE_WEIGHT=0.30
REVENUE_WEIGHT=0.15
TECH_STACK_WEIGHT=0.15
FIRMOGRAPHIC_WEIGHT=0.60
INTENT_WEIGHT=0.40

# ── Qualifier persona weights (PersonaWeights + axis splits) ──────────────
PRIMARY_ROLE_MATCH=40.0
STARTUP_FALLBACK_MATCH=35.0
PARTIAL_TITLE_MATCH=20.0
ENGAGEMENT_WEIGHT=40.0
VERIFIED_EMAIL_BONUS=20.0
RISKY_EMAIL_BONUS=5.0
FIT_WEIGHT=0.70
REACHABILITY_WEIGHT=0.20
TIMING_WEIGHT=0.10
FUNCTIONAL_WEIGHT=0.60
AUTHORITY_WEIGHT=0.40

# When true, Phase A uses fixtures instead of live MCP (offline smoke)
ORCHESTRATOR_MOCK=false

# Default ICP + offering (smoke scripts; API uses these if body omits them)
# Full shape the extractor understands:
#   must_have: industry, company_size, location (country and/or continent)
#   nice_to_have: revenue_range, cities, tech_stack, growth_stage, funding_stage
#   exclude: industries, keywords, company_size
#   target_roles: persona titles
# Tip: only mention revenue/tech if you want them scored; omitted fields stay null/[] and are skipped.


ICP_DESCRIPTION_TEXT="We sell NudgeShield cyber-risk analytics to mid-market insurance and financial services companies in the United States. Contact risk, underwriting, and revenue leaders.

- Industry: Insurance, Financial Services, Banking, Fintech
- Company size: 200 to 5000 employees
- Located in: United States

- Annual revenue / ARR: $10,000,000 to $500,000,000
- Preferred cities: San Francisco (United States), New York (United States), Austin (United States)
- Tech stack: Guidewire, Salesforce, Snowflake, AWS, Tableau, Slack
- Growth stage: growth stage
- Funding stage: Series B, Series C, or later

Exclude:
- Industries: Gambling, Government, Non-profit, Software
- Keywords: agency, staffing, consulting-only, competitor
- Company size under 50 employees

Target roles:
- VP of Sales
- Head of Sales
- Director of Sales
- Chief Revenue Officer
- Head of Revenue Operations
- Sales Operations Manager"

USER_OFFERING="NudgeShield is a cyber-risk and underwriting intelligence platform that helps insurers and financial institutions detect emerging threats, score account risk, and prioritize high-intent commercial opportunities."

# API
API_HOST=0.0.0.0
API_PORT=8100
LOG_LEVEL=INFO
LOCAL_COMPANY_MIN_HITS=2

# ── Outreach Orchestrator integration ────────────────────────────────────
# Path to the Outreach Orchestrator stdio MCP server entrypoint (REQUIRED)
# This wrapper preserves the package context needed by app/mcp_server.py.
OUTREACH_MCP_PATH=../../Outreach-Project/outreach orchestrator/run_mcp.py
# Optional Python interpreter for the Outreach MCP subprocess (defaults to current python)
OUTREACH_PYTHON=
# Max seconds to wait for a single Outreach MCP tool call (prevents hung Gemini calls)
OUTREACH_TIMEOUT=120.0
# How many times to retry a failed MCP tool call before giving up
OUTREACH_MAX_RETRIES=2
# Base seconds for exponential backoff between retries (delay = base * 2^attempt)
OUTREACH_RETRY_BACKOFF_BASE=2.0

# Default sender/offer values for Phase B outreach
OUTREACH_DEFAULT_SENDER_COMPANY=My Company
OUTREACH_DEFAULT_SENDER_ELEVATOR_PITCH=
OUTREACH_DEFAULT_OFFER_NAME=Default Offer
OUTREACH_DEFAULT_SOLUTION_SUMMARY=
OUTREACH_DEFAULT_CTA=
OUTREACH_DEFAULT_APPROVAL_MODE=per_sequence
OUTREACH_DEFAULT_USE_NATIVE_LANGUAGE=false
OUTREACH_DEFAULT_MESSAGE_LANGUAGE=
OUTREACH_DEFAULT_HAS_INMAIL_CREDITS=false
OUTREACH_DEFAULT_DEBUG_MODE=true

# If true, Phase A automatically hands off to Phase B when a lead package is ready
OUTREACH_AUTO_START=false
