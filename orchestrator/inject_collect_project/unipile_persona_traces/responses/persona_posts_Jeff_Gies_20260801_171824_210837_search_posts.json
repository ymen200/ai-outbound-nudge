          "profile_picture_url": "https://media.licdn.com/dms/image/v2/C4E03AQFSegerbVmHCw/profile-displayphoto-shrink_200_200/profile-displayphoto-shrink_200_200/0/1516299615762?e=1787184000&v=beta&t=BD42WN_CbFHIVTACYDMJ9ZKuyc4riqvwcABF1srN5LE"
