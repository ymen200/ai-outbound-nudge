        "text": "This will be a great event with two world class leaders.",
        "mentions": [],
        "attachments": [],
        "author": {
          "public_identifier": "chimejeffgies",
          "id": "ACoAAACUkbwBKu21MBMFtZSFsAM6Kn_FoA5YORU",
          "name": "Jeff Gies",
          "is_company": false,
          "headline": "Sales Leader/Team Builder",
          "profile_picture_url": "https://media.licdn.com/dms/image/v2/C4E03AQFSegerbVmHCw/profile-displayphoto-shrink_200_200/profile-displayphoto-shrink_200_200/0/1516299615762?e=1787788800&v=beta&t=bxEAfukBWJ8ao0R29ExWvnOWzE39tn9kj1_SSsPJPWc"
