        "social_id": "urn:li:ugcPost:7452626466921553920",
        "share_url": "https://www.linkedin.com/posts/asma-a-1824a8209_on-ne-tourne-pas-une-page-on-%C3%A9crit-un-nouveau-activity-7452626621490089984-HuI2?utm_source=social_share_send&utm_medium=member_desktop_web&rcm=ACoAAD0L5_ABojwX1DGaB4P6TLLJ7y_trHH9GXc",
        "date": "2mo",
