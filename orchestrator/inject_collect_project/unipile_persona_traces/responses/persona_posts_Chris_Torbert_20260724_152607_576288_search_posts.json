          "is_company": false,
          "headline": "Sr. Director, Enterprise Sales @ ClickUp",
          "profile_picture_url": "https://media.licdn.com/dms/image/v2/D4D35AQHg9euoBFslqA/profile-framedphoto-shrink_200_200/B4DZ1Ok6wuH4AY-/0/1775139794323?e=1785510000&v=beta&t=UzrtKKdJEYjw-vMKGFR3wcXMsZ9jgfOVSIbf4l3T_SE"
