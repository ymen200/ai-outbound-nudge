      {
        "type": "POST",
        "provider": "LINKEDIN",
        "social_id": "urn:li:activity:7391556111474278400",
        "share_url": "https://www.linkedin.com/posts/michael-mckeon-2459642_thrilled-to-partner-with-my-friendsukg-activity-7391556111474278400-AC0G?utm_source=social_share_send&utm_medium=member_desktop_web&rcm=ACoAAAb5xloBAjquIMcq59NNupJ6dxbXVTCmLWk",
        "date": "8mo",
        "comment_counter": 1,
        "impressions_counter": 0,
        "reaction_counter": 35,
        "repost_counter": 0,
        "permissions": {
          "can_post_comments": true,
          "can_react": true,
          "can_share": true
        },
        "text": "Thrilled to partner with my friends, @UKG, and welcome @maxwell.randall Group — a shared employer partner — to show what’s possible when employers invest in their people’s financial future.Together, we’re bringing Chime Workplace, our seamless, no-cost financial wellness suite, to even more frontline workers. Through our integration with UKG, employers like Maxwell can now offer tools that go beyond access to pay — helping employees save, spend, and get ahead with confidence.These partnerships couldn’t come at a more important time where employers are looking to do more with less, build resilience with their frontline teams, and support employees in their personal life.",
        "mentions": [],
        "attachments": [
          {
            "id": "D5622AQFXJbsUD5LYKg",
            "sticker": false,
            "size": {
              "height": 456,
