# ===================================
# Neo4j Configuration (AuraDB)
# ===================================
NEO4J_URI=neo4j+s://your-cluster-id.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-secure-password-here

# Use local Neo4j instead of AuraDB (set to true if using docker-compose neo4j service)
USE_LOCAL_NEO4J=false
LOCAL_NEO4J_URI=bolt://neo4j:7687
LOCAL_NEO4J_USER=neo4j
LOCAL_NEO4J_PASSWORD=password123

# Min ICP-matching companies in Neo4j to skip Apollo organizations/search (default 2).
# If fewer matches are found, Apollo runs and skips companies already present in Neo4j.
LOCAL_COMPANY_MIN_HITS=2

# ===================================
# Core API Keys (required)
# ===================================
GEMINI_API_KEY=your-gemini-api-key-here
APOLLO_API_KEY=your-apollo-api-key-here
ESPRIT_TOKEN_FACTORY_KEY=your-esprit-token-factory-key-here

# Legacy alias (optional if ESPRIT_TOKEN_FACTORY_KEY is set)
# ESPRIT_LLM_API_KEY=your-esprit-token-factory-key-here

# ===================================
# LLM fallback (ESPRIT -> Groq)
# ===================================
# auto = ping ESPRIT (~ESPRIT_HEALTHCHECK_TIMEOUT sec) then Groq if down
# esprit | groq = force a provider
LLM_PROVIDER=auto
ESPRIT_HEALTHCHECK_TIMEOUT=10
GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=llama-3.3-70b-versatile

# ===================================
# Unipile (LinkedIn persona posts)
# ===================================
UNIPILE_API_KEY=your-unipile-api-key-here
UNIPILE_DSN=https://apiXX.unipile.com:PORT
# Prefer a fixed account_id once the LinkedIn account is connected.
# If empty, the scraper will list existing LINKEDIN accounts or create one via li_at.
UNIPILE_ACCOUNT_ID=
# Cookie auth (li_at) — used when UNIPILE_ACCOUNT_ID is empty
# Docs: POST /api/v1/accounts  provider=LINKEDIN  access_token=<li_at>
UNIPILE_LI_AT=
# Optional premium cookie (Sales Navigator / Recruiter)
# UNIPILE_LI_A=
# Optional browser user-agent (recommended to avoid disconnection)
# UNIPILE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36
UNIPILE_POSTED_LIMIT=month
UNIPILE_TARGET_COUNT=10

# ===================================
# Persona Enrichment APIs (optional / archive scripts)
# ===================================
SERPER_API_KEY=your-serper-api-key-here
HUNTER_API_KEY=your-hunter-api-key-here
SNOVIO_CLIENT_ID=your-snovio-client-id-here
SNOVIO_CLIENT_SECRET=your-snovio-client-secret-here
TOMBA_API_KEY=your-tomba-api-key-here
TOMBA_API_SECRET=your-tomba-api-secret-here
AEROLEADS_API_KEY=your-aeroleads-api-key-here
FULLENRICH_API_KEY=your-fullenrich-api-key-here
UPLEAD_API_KEY=your-uplead-api-key-here
CONTACTOUT_API_KEY=your-contactout-api-key-here
ROCKETREACH_API_KEY=your-rocketreach-api-key-here
LEADIQ_API_KEY=your-leadiq-api-key-here

# ===================================
# Application Configuration
# ===================================
LOG_LEVEL=INFO
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# SmartScraperAI orchestration: true = LangGraph (default), false = legacy while-loop
USE_SCRAPER_GRAPH=true

# Company discover: true = LangGraph per-company enrichment (default), false = legacy inline loop
USE_COMPANY_GRAPH=true

# Contact enrich: true = LangGraph persona waterfall (default), false = legacy inline loop
USE_CONTACT_GRAPH=true

# Max intent signals (jobs + news + scraper) kept per company in main_discovery
MAX_INTENT_SIGNALS_PER_COMPANY=30

# Max age (days) for Apollo job postings and news articles in main_discovery
MAX_JOB_AGE_DAYS=30
MAX_NEWS_AGE_DAYS=180

# Cron company refresh: select companies whose current version is older than N days
CRON_COMPANY_MAX_AGE_DAYS=7
CRON_COMPANY_BATCH_LIMIT=50
CRON_PERSONA_LIMIT_PER_COMPANY=10
CRON_PERSONA_LIMIT_PER_ELEMENT=3

# APScheduler (weekly). false = le jour arrive mais le job ne fait rien
CRON_SCHEDULER_ENABLED=false
CRON_SCHEDULER_DAY=mon
CRON_SCHEDULER_HOUR=3
CRON_SCHEDULER_MINUTE=0
